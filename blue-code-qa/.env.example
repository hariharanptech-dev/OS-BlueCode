# Copy to .env (never commit .env). All values below are PLACEHOLDERS.
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
PAYU_KEY=replace-with-your-payu-merchant-key
PAYU_SALT=replace-with-your-payu-merchant-salt
PAYU_BASE_URL=https://test.payu.in/_payment
PAYU_VERIFY_URL=https://test.payu.in/merchant/postservice.php?form=2
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
MOCK_PAYU_UI=false
