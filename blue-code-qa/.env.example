# Copy to .env (never commit .env). All values below are PLACEHOLDERS.
# For production, set NODE_ENV=production and use live PayU credentials
NODE_ENV=production
PORT=3000
APP_BASE_URL=https://your-frontend-domain.com
ALLOWED_ORIGINS=https://your-frontend-domain.com
PAYU_KEY=your-live-merchant-key-here
PAYU_SALT=your-live-merchant-salt-here
PAYU_BASE_URL=https://secure.payu.in/_payment
PAYU_VERIFY_URL=https://info.payu.in/merchant/postservice.php?form=2
COOKIE_SECURE=true
TRUST_PROXY_HOPS=1
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
MOCK_PAYU_UI=false
