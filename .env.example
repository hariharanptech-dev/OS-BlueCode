# Blue Code OS - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ===========================================
# Application
# ===========================================
NODE_ENV=development
PORT=4000

# ===========================================
# Database (PostgreSQL)
# ===========================================
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bluecode_os?schema=public

# ===========================================
# Session
# ===========================================
# Must be at least 32 characters
SESSION_SECRET=your-super-secret-session-key-at-least-32-chars-long

# ===========================================
# Frontend & Backend URLs
# ===========================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# ===========================================
# PayU Configuration
# ===========================================
# Get these from your PayU merchant dashboard
# For development, use test credentials from PayU sandbox
PAYU_MERCHANT_KEY=your-payu-merchant-key
PAYU_MERCHANT_SALT=your-payu-merchant-salt
PAYU_BASE_URL=https://test.payu.in/_payment
PAYU_VERIFY_URL=https://test.payu.in/merchant/postservice?form=2

# ===========================================
# Frontend (Next.js)
# ===========================================
# Set to 'true' to use mock API (development only)
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1