# ==========================================
# Blue Code OS — Unified Environment Template (Production Ready)
# ==========================================
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to version control

# 1. Server Configuration (Backend)
NODE_ENV=production
PORT=4000
BACKEND_URL=https://your-backend-domain.com
FRONTEND_URL=https://your-frontend-domain.com
SESSION_SECRET=replace-with-64-character-random-hex-string-for-security

# 2. Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/bluecode?schema=public
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/bluecode_test?schema=public
IDEMPOTENCY_TTL_HOURS=24
SEED_SAMPLE_PRICE_MINOR=100

# 3. PayU Gateway Credentials (India) - LIVE PRODUCTION
# Get these from your PayU Merchant Dashboard (https://merchant.payu.in)
# Authorized Merchant ID: 13844503 (do not change)
PAYU_MERCHANT_ID=13844503
PAYU_MERCHANT_KEY=your-live-merchant-key-here
PAYU_MERCHANT_SALT=your-live-merchant-salt-here
PAYU_BASE_URL=https://secure.payu.in/_payment
PAYU_VERIFY_URL=https://info.payu.in/merchant/postservice.php?form=2

# 4. Frontend Configuration
NEXT_PUBLIC_USE_MOCK=false
