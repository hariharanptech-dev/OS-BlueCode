# ==========================================
# Blue Code OS — Development Environment Template
# ==========================================
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to version control

# 1. Server Configuration (Backend)
NODE_ENV=development
PORT=4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
SESSION_SECRET=replace-with-64-character-random-hex-string-for-development

# 2. Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/bluecode?schema=public
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/bluecode_test?schema=public
IDEMPOTENCY_TTL_HOURS=24
SEED_SAMPLE_PRICE_MINOR=100

# 3. PayU Gateway Credentials (India) - TEST ENVIRONMENT
# Get these from your PayU Test Merchant Dashboard (https://test.payu.in)
# Sign up for a test account at https://test.payu.in to get test credentials
# Test Merchant ID is DIFFERENT from production MID (13844503)
PAYU_MERCHANT_ID=your-test-merchant-id-here
PAYU_MERCHANT_KEY=your-test-merchant-key-here
PAYU_MERCHANT_SALT=your-test-merchant-salt-here
PAYU_BASE_URL=https://test.payu.in/_payment
PAYU_VERIFY_URL=https://test.payu.in/merchant/postservice?form=2

# 4. Frontend Configuration
NEXT_PUBLIC_USE_MOCK=false