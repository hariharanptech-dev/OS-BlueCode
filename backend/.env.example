# Production Configuration for PayU Live Payments
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to version control

NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/bluecode?schema=public
SESSION_SECRET=replace-with-64-random-hex-chars
FRONTEND_URL=https://your-frontend-domain.com
BACKEND_URL=https://your-backend-domain.com

# PayU India Live Production Configuration
# Get these from your PayU Merchant Dashboard (https://merchant.payu.in)
# Authorized Merchant ID: 13844503 (do not change)
PAYU_MERCHANT_ID=13844503
PAYU_MERCHANT_KEY=your-live-merchant-key-here
PAYU_MERCHANT_SALT=your-live-merchant-salt-here
PAYU_BASE_URL=https://secure.payu.in/_payment
PAYU_VERIFY_URL=https://info.payu.in/merchant/postservice.php?form=2
