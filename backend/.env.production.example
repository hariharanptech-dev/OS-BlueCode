# ============================================================
# Blue Code OS — PRODUCTION Environment Template
# Copy this file to backend/.env and fill in your LIVE values.
# NEVER commit the filled-in .env to version control.
# ============================================================

NODE_ENV=production
PORT=4000

# --- Server URLs (must be HTTPS in production) ---
BACKEND_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# --- Database ---
DATABASE_URL=postgresql://USER:PASSWORD@your-db-host:5432/bluecode?schema=public&sslmode=require

# --- Session Security (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ---
SESSION_SECRET=<64-char-hex-string>

# --- PayU LIVE Production Credentials (MID 13844503 is enforced at startup) ---
PAYU_MERCHANT_ID=13844503
PAYU_MERCHANT_KEY=<your_live_merchant_key>
PAYU_MERCHANT_SALT=<your_live_merchant_salt>
PAYU_BASE_URL=https://secure.payu.in/_payment
PAYU_VERIFY_URL=https://info.payu.in/merchant/postservice?form=2
