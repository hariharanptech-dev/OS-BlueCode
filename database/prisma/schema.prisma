// Blue Code OS - database schema.
//
// Conventions (shared contract with the payment-integration module):
//   * UUID primary keys (generated by the DATABASE: gen_random_uuid()).
//   * Tables/columns are snake_case in SQL (via @map/@@map), camelCase in TypeScript.
//   * All timestamps are timestamptz(3) and are UTC at the application layer.
//   * Money is stored as INTEGER MINOR UNITS (e.g. paise for INR) + ISO-4217 currency. Never floats.
//
// NOT expressible in Prisma and therefore defined ONLY in the hand-written migration SQL:
//   * CHECK constraints (positive amounts, lower-case email, SUCCESS requires verification, ...)
//   * Partial unique index: one ACTIVE subscription per user
//   * EXCLUDE constraint (btree_gist): no overlapping live subscription windows per user
//   * Immutability / append-only / state-transition triggers
// See DATABASE_ARCHITECTURE.md ("Constraints Prisma cannot express").

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED

  @@map("account_status")
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM

  @@map("billing_interval")
}

enum PaymentProvider {
  PAYU

  @@map("payment_provider")
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED

  @@map("payment_status")
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED

  @@map("subscription_status")
}

enum PaymentEventType {
  PAYMENT_CREATED
  REDIRECTED_TO_PROVIDER
  CALLBACK_RECEIVED
  WEBHOOK_RECEIVED
  VERIFICATION_SUCCEEDED
  VERIFICATION_FAILED
  VERIFICATION_MISMATCH
  PAYMENT_STATUS_CHANGED
  SUBSCRIPTION_ACTIVATED
  RECONCILIATION_CHECKED

  @@map("payment_event_type")
}

enum EventProcessingStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED

  @@map("event_processing_status")
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED

  @@map("idempotency_status")
}

model User {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String        @db.VarChar(200)
  email         String        @unique @db.VarChar(320) // always stored lower-case (DB CHECK)
  passwordHash  String        @map("password_hash") // argon2/bcrypt hash only; never plain text
  accountStatus AccountStatus @default(ACTIVE) @map("account_status")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  payments           Payment[]
  subscriptions      Subscription[]
  idempotencyRecords IdempotencyRecord[]

  @@map("users")
}

model Plan {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String          @unique @db.VarChar(64)
  name            String          @db.VarChar(200)
  description     String?
  priceMinor      Int             @map("price_minor") // authoritative price, minor units (> 0)
  currency        String          @db.Char(3)
  billingInterval BillingInterval @map("billing_interval") // informational label
  durationDays    Int             @map("duration_days") // authoritative entitlement length
  features        Json            @default("{}")
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  payments      Payment[]
  subscriptions Subscription[]

  @@map("plans")
}

model Payment {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String          @map("user_id") @db.Uuid
  planId                String          @map("plan_id") @db.Uuid
  orderId               String          @unique @map("order_id") @db.VarChar(64) // internal order id
  transactionId         String          @map("transaction_id") @db.VarChar(64) // merchant txnid sent to PayU (<=25 chars)
  provider              PaymentProvider @default(PAYU)
  providerTransactionId String?         @map("provider_transaction_id") @db.VarChar(128) // PayU mihpayid
  amountMinor           Int             @map("amount_minor") // snapshot of plan price at order time
  currency              String          @db.Char(3)
  planDurationDays      Int             @map("plan_duration_days") // snapshot of plan duration at order time
  status                PaymentStatus   @default(CREATED)
  failureReason         String?         @map("failure_reason") @db.VarChar(255)
  idempotencyKey        String          @map("idempotency_key") @db.VarChar(128)
  initiatedAt           DateTime        @default(now()) @map("initiated_at") @db.Timestamptz(3)
  verifiedAt            DateTime?       @map("verified_at") @db.Timestamptz(3)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan         Plan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  events       PaymentEvent[]
  subscription Subscription?

  @@unique([provider, transactionId], map: "payments_provider_transaction_id_key")
  @@unique([provider, providerTransactionId], map: "payments_provider_provider_transaction_id_key")
  @@unique([userId, idempotencyKey], map: "payments_user_idempotency_key_key")
  @@index([userId, createdAt(sort: Desc)], map: "payments_user_created_idx")
  @@index([status, initiatedAt], map: "payments_status_initiated_idx")
  @@index([planId], map: "payments_plan_idx")
  @@map("payments")
}

model Subscription {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  planId            String             @map("plan_id") @db.Uuid
  paymentId         String             @unique @map("payment_id") @db.Uuid // 1 payment -> at most 1 subscription
  status            SubscriptionStatus @default(PENDING)
  startDate         DateTime           @map("start_date") @db.Timestamptz(3)
  endDate           DateTime           @map("end_date") @db.Timestamptz(3)
  activatedAt       DateTime?          @map("activated_at") @db.Timestamptz(3)
  suspendedAt       DateTime?          @map("suspended_at") @db.Timestamptz(3)
  cancelledAt       DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  statusReason      String?            @map("status_reason") @db.VarChar(255)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan    Plan                @relation(fields: [planId], references: [id], onDelete: Restrict)
  payment Payment             @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  events  SubscriptionEvent[]

  @@index([userId, status], map: "subscriptions_user_status_idx")
  @@index([status, endDate], map: "subscriptions_status_end_idx")
  @@index([planId], map: "subscriptions_plan_idx")
  @@map("subscriptions")
}

/// Append-only audit trail of subscription status changes.
model SubscriptionEvent {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String              @map("subscription_id") @db.Uuid
  fromStatus     SubscriptionStatus? @map("from_status")
  toStatus       SubscriptionStatus  @map("to_status")
  reason         String?             @db.VarChar(255)
  actor          String              @db.VarChar(64) // SYSTEM | PAYMENT_ACTIVATION | EXPIRY_JOB | ADMIN:<id> ...
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([subscriptionId, createdAt], map: "subscription_events_sub_created_idx")
  @@map("subscription_events")
}

/// Append-only audit trail of everything that happened to a payment. Payload is SANITIZED (allow-list).
model PaymentEvent {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId         String                @map("payment_id") @db.Uuid
  eventType         PaymentEventType      @map("event_type")
  providerReference String?               @map("provider_reference") @db.VarChar(128)
  payload           Json                  @default("{}")
  processingStatus  EventProcessingStatus @default(RECEIVED) @map("processing_status")
  receivedAt        DateTime              @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt       DateTime?             @map("processed_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, receivedAt], map: "payment_events_payment_received_idx")
  @@index([providerReference], map: "payment_events_provider_ref_idx")
  @@map("payment_events")
}

model IdempotencyRecord {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  idempotencyKey     String            @map("idempotency_key") @db.VarChar(128)
  requestFingerprint String            @map("request_fingerprint") @db.Char(64) // sha256 hex of canonical request
  responseReference  String?           @map("response_reference") @db.VarChar(128) // e.g. payment id
  status             IdempotencyStatus @default(IN_PROGRESS)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt          DateTime          @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey], map: "idempotency_user_key_key")
  @@index([expiresAt], map: "idempotency_expires_idx")
  @@map("idempotency_records")
}
