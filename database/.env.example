# Application database (PostgreSQL 14+; btree_gist extension required)
DATABASE_URL="postgresql://bluecode:CHANGE_ME@localhost:5432/bluecode?schema=public"
# Used only by the Jest suite. MUST point at a throw-away database: it is wiped on every run.
TEST_DATABASE_URL="postgresql://bluecode:CHANGE_ME@localhost:5432/bluecode_test?schema=public"
# Seed (development only). Sample plan price in MINOR units (100 = INR 1.00). Placeholder, NOT a commercial price.
SEED_SAMPLE_PRICE_MINOR=100
IDEMPOTENCY_TTL_HOURS=24
